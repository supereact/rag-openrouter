# Copy to deploy/.env.deploy; do NOT commit that file.
# This URL is for *inside* the containers. Use the EXISTING DB container DNS name,
# not localhost. URL-encode special password characters.
RAG_DEPLOY_DATABASE_URL=postgresql://raguser:REPLACE_WITH_YOUR_PASSWORD@enterprise-rag-postgres:5432/ragdb
# Set these to `id -u` and `id -g` on the Mac host (e.g., 501 / 20).
RAG_UID=501
RAG_GID=20
RAG_WEB_PORT=8080
