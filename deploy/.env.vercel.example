# Reference only: enter values in the Vercel BACKEND project's environment UI.
# Never upload a filled copy or use the Neon owner/maintenance database URL.
DATABASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAG_STORAGE_BACKEND=s3
RAG_DOCUMENTS_BUCKET=rag-documents
RAG_UPLOADS_BUCKET=rag-uploads
RAG_UPLOAD_SIGNING_KEY=
RAG_ALLOWED_ORIGINS=https://app.example.com

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
RAG_PUBLIC_REGISTRATION_ENABLED=true
RAG_PAYMENTS_MODE=disabled
RAG_WALLET_ENFORCEMENT=false
RAG_SUPPORT_STAFF_USER_IDS=

# Select the SAME IDs and immutable revisions for API and worker builds.
# These public revisions match the cached models checked in this workspace.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RAG_RETRIEVAL_MODE=rerank
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
UV_TORCH_BACKEND=cpu

# FRONTEND project only (Root Directory: frontend):
# VITE_API_BASE_URL=https://api.example.com
# VITE_CREDITS_ENABLED=false
# VITE_DIRECT_UPLOADS=false
