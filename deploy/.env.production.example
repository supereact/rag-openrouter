# REMOTE SERVER ONLY. Copy to deploy/.env.production and chmod 600 it.
# Never use `docker compose config` without --quiet: it can print secrets.
RAG_RELEASE=
RAG_PUBLIC_HOST=
RAG_TLS_EMAIL=
RAG_DATA_DIR=/srv/rag-data

# Generate independent strong passwords; URL-encode them inside both URLs.
# Runtime URL: postgresql://rag_app:<encoded-password>@postgres:5432/ragdb
# Migration URL: postgresql://rag_owner:<encoded-password>@postgres:5432/ragdb
RAG_DB_OWNER_PASSWORD=
RAG_DB_APP_PASSWORD=
RAG_PRODUCTION_DATABASE_URL=
RAG_MIGRATION_DATABASE_URL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Must match the local database's embedding model. Changing it requires reembedding.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RETRIEVAL_MODE=rerank
RAG_SUPPORT_STAFF_USER_IDS=
