# Pull production credentials with:
# neon env pull --service postgres,object-storage --file .env.neon
# Never use the default env pull; it would overwrite your local DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

RAG_STORAGE_BACKEND=s3
RAG_DOCUMENTS_BUCKET=rag-documents
RAG_UPLOADS_BUCKET=rag-uploads
# Server-only random secret, shared by API instances; never use a VITE_ prefix.
RAG_UPLOAD_SIGNING_KEY=
# Match the chosen embedding model across the Neon API and worker (384 dimensions).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RETRIEVAL_MODE=rerank
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
RAG_ALLOWED_ORIGINS=
RAG_PUBLIC_REGISTRATION_ENABLED=true
RAG_PAYMENTS_MODE=disabled
RAG_WALLET_ENFORCEMENT=false
