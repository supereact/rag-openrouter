# LOCAL DEVELOPMENT ONLY — do not commit your real .env or API keys.
DATABASE_URL=postgresql://raguser:local_only_password@127.0.0.1:5432/ragdb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Choose "openrouter" (default) or "openai".
LLM_PROVIDER=openrouter

# OpenRouter — used by POST /ask when LLM_PROVIDER=openrouter
# Create a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Direct OpenAI — used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Milestone 7: generated by scripts.create_api_key after migrate_security.
# Needed for trusted local seed/evaluation scripts; do not share or commit.
RAG_ADMIN_API_KEY=

# Choose vector, hybrid, or rerank (as in M6)
RAG_RETRIEVAL_MODE=rerank

# Optional USDT prepaid credits. Never put these secrets in frontend variables.
# Run scripts.migrate_credits during approved maintenance before enabling.
RAG_PAYMENTS_MODE=disabled
RAG_WALLET_ENFORCEMENT=false
# Public HTTPS origin, including /api when callbacks pass through the web proxy.
RAG_PAYMENTS_CALLBACK_BASE_URL=
NOWPAYMENTS_SANDBOX_API_KEY=
NOWPAYMENTS_SANDBOX_IPN_SECRET=
# Set live credentials only after the merchant account is approved.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional central live support. Run scripts.migrate_support before use.
# Comma-separated global user IDs of explicitly designated administrator accounts.
# Empty disables new support chats. This does not grant document/tenant access.
RAG_SUPPORT_STAFF_USER_IDS=

# New public accounts create isolated editor workspaces. Invitations still work.
# Apply scripts.migrate_starter_allowances before deploying the new release.
RAG_PUBLIC_REGISTRATION_ENABLED=true

# Exact frontend origins for direct cross-origin API calls; no wildcard.
# Production: https://app.example.com (with backend https://api.example.com).
# Local direct calls: http://127.0.0.1:5173 or http://localhost:5173.
RAG_ALLOWED_ORIGINS=

# Local remains the default. Neon uses a separate .env.neon and explicit launcher.
RAG_STORAGE_BACKEND=local
RAG_DOCUMENTS_BUCKET=rag-documents
RAG_UPLOADS_BUCKET=rag-uploads
# Server-only, at least 32 random bytes for direct upload authorizations. Local uploads do not need it.
RAG_UPLOAD_SIGNING_KEY=
