# Public build-time setting. Rebuild the frontend after changing it.
# Never put provider credentials or payment secrets in VITE_ variables.
VITE_CREDITS_ENABLED=false

# Vercel: set this to the VPS HTTPS origin, e.g. https://api.example.com.
# This is public configuration. No provider credentials belong here.
# Unset locally to retain the existing /api development proxy.
VITE_API_BASE_URL=

# Set true for Vercel after configuring the private Neon bucket CORS and API signing key.
VITE_DIRECT_UPLOADS=false
