FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1
WORKDIR /srv/rag
RUN python -m pip install torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt ./requirements.txt
RUN python -m pip install -r requirements.txt
COPY app ./app
COPY scripts ./scripts
# Only public model identifiers are accepted as build arguments, never secrets.
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ARG RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ARG RAG_RETRIEVAL_MODE=rerank
# Match the release's default model IDs even when a builder omits build args.
# Custom model releases must override both their IDs and revisions together.
ARG RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
ARG RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RUN HF_HOME=/tmp/rag-build-model-cache python -m scripts.prepare_model_bundle --require-cpu --require-revisions \
    && rm -rf /tmp/rag-build-model-cache
RUN groupadd --gid 10001 rag && useradd --uid 10001 --gid rag --no-create-home rag \
    && chown -R 10001:10001 /srv/rag/model_bundle
USER 10001:10001
CMD ["python", "-m", "scripts.hosted_worker", "--poll-seconds", "15"]
